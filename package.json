{
  "name": "book-my-show-backend",
  "version": "1.0.0",
  "description": "BookMyShow high-performance backend service with Fastify and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "oxlint .",
    "seed": "tsx scripts/seed.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test:k6": "k6 run scripts/load-test.k6.js",
    "cluster:start": "tsc && pm2 start ecosystem.config.cjs",
    "cluster:stop": "pm2 stop ecosystem.config.cjs",
    "cluster:restart": "tsc && pm2 restart ecosystem.config.cjs",
    "cluster:monit": "pm2 monit",
    "cluster:logs": "pm2 logs",
    "nginx:start": "powershell -Command \"Start-Process .\\nginx-1.26.2\\nginx.exe -ArgumentList '-p E:/Projects/System-Design/Book-my-show/nginx-1.26.2 -c E:/Projects/System-Design/Book-my-show/nginx-windows.conf'\"",
    "nginx:stop": ".\\nginx-1.26.2\\nginx.exe -p E:/Projects/System-Design/Book-my-show/nginx-1.26.2 -c E:/Projects/System-Design/Book-my-show/nginx-windows.conf -s stop",
    "nginx:reload": ".\\nginx-1.26.2\\nginx.exe -p E:/Projects/System-Design/Book-my-show/nginx-1.26.2 -c E:/Projects/System-Design/Book-my-show/nginx-windows.conf -s reload",
    "nginx:local": "docker compose -f docker/nginx/compose.yml up"
  },
  "keywords": [
    "fastify",
    "typescript",
    "book-my-show",
    "mongodb",
    "redis",
    "elasticsearch"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "mongoose": "^8.10.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "oxlint": "^0.15.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
