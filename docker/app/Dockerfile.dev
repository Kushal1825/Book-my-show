# ============================================================
# Development Dockerfile — hot-reload via tsx watch
# ============================================================
FROM node:22-alpine

LABEL maintainer="BookMyShow Backend Team"
LABEL description="BookMyShow backend — development environment"

WORKDIR /app

# Enable pnpm via corepack (ships with Node 22)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependency manifests and install all dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install

# Copy the entire project source
COPY . .

# Expose the application port
EXPOSE 3000

# Start in dev mode with hot-reload (tsx watch)
CMD ["pnpm", "run", "dev"]
